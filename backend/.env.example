# Local backend defaults. Never put real production secrets in this file.
DB_USERNAME=careconnect_user
DB_PASSWORD=replace-with-your-local-database-password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/careconnect
# For Neon production, set SPRING_DATASOURCE_URL to the pooled JDBC URL
# and SPRING_FLYWAY_URL to the direct (non-pooler) JDBC URL.

# Generate a unique production secret; do not reuse this example.
CARECONNECT_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CARECONNECT_JWT_ISSUER=careconnect-api

# Set these in Render to the exact Cloudflare Pages production origin and URL.
CARECONNECT_CORS_ALLOWED_ORIGINS=http://localhost:5173
CARECONNECT_FRONTEND_VERIFICATION_URL=http://localhost:5173/verify-email

CARECONNECT_AUTH_EMAIL_VERIFICATION_REQUIRED=true
CARECONNECT_ADMIN_BOOTSTRAP_ENABLED=false
CARECONNECT_ADMIN_EMAIL=
CARECONNECT_ADMIN_PASSWORD=

CARECONNECT_MAIL_HOST=smtp.gmail.com
CARECONNECT_MAIL_PORT=587
CARECONNECT_MAIL_USERNAME=
CARECONNECT_MAIL_PASSWORD=
